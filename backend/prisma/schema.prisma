generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model User{
  login String @id
  name String
  password String
  lives Int @default(3)
  
  timezone String @default("UTC")

  templateID Templates[] @relation("template_profile")

  @@map("users")
}

model Templates {
  id String @id @default(ulid())
  title String @unique
  description String  

  quest Quests[] @relation("template_quests")

  userID String
  user User @relation("template_profile", fields: [userID], references: [login], onDelete: Cascade)

  completed_count Int @default(0) @map("completed_count")
  interval Int @default(1) @map("days_interval")
  nextRunAt DateTime @db.Date @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  

  @@map("templates")
  @@index([completed_count, createdAt])
}

model Quests {
  id String @id @default(ulid())

  templateID String @map("template_id")

  template Templates @relation("template_quests", fields: [templateID], references: [id], onDelete: Cascade)

  date DateTime @db.Date @default(now()) @map("next_run_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status questStatus @default(NOTCOMPLATED)

  @@index([date])
  @@map("quests")
}

enum questStatus{
  COMPLEATED
  NOTCOMPLATED
  BURN
  OVERDUE

  @@map("enum_questStatus")
}