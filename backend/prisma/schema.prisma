// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

model User{
  id String @id @default(uuid())
  name String
  lives Int

  @@map("users")
}

model Templates {
  id String @id @default(ulid())
  title String @unique
  description String

  quest Quests[] @relation("template_quests")

  completed_count Int @default(0) @map("completed_count")
  interval Int @default(1) @map("days_interval")
  nextRunAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
  @@index([createdAt])
}

model Quests {
  id String @id @default(ulid())

  templateID String @map("template_id")

  template Templates @relation("template_quests", fields: [templateID], references: [id], onDelete: Cascade)

  date DateTime @default(now()) @map("next_run_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status questStatus @default(NOTCOMPLATED)

  @@index([date])
  @@map("quests")
}

enum questStatus{
  COMPLEATED
  NOTCOMPLATED
  BURN

  @@map("enum_questStatus")
}